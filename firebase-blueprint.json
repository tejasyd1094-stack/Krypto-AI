{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account status, subscription, and career profile details.",
      "type": "object",
      "properties": {
        "isPro": { "type": "boolean" },
        "planId": { "type": "string" },
        "credits": { "type": "integer" },
        "trialUsed": { "type": "boolean" },
        "location": { "type": "string" },
        "currency": { "type": "string" },
        "symbol": { "type": "string" },
        "tasks": { "type": "object" },
        "profile": { "type": "object" }
      },
      "required": ["credits", "planId"]
    },
    "HistoryItem": {
      "title": "HistoryItem",
      "description": "A generated analysis or report item stored in user history.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "inputs": { "type": "object" },
        "result": { "type": "string" },
        "score": { "type": "number" },
        "breakdown": { "type": "object" },
        "improvements": { "type": "array" },
        "optimizedResult": { "type": "string" }
      },
      "required": ["id", "type", "title", "date", "result"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Feedback, ratings, queries, and consultation requests routed to support@kryptonpath.co.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "rating": { "type": "number" },
        "module": { "type": "string" },
        "comment": { "type": "string" },
        "org": { "type": "string" },
        "message": { "type": "string" },
        "userUid": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["type", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Primary user profile, state, and career metadata mapping."
    },
    "users/{userId}/history/{historyId}": {
      "schema": "HistoryItem",
      "description": "Historical re-engineered templates, simulations, and career calculations."
    },
    "support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "User queries, ratings, feedback, and expert consultation requests."
    }
  }
}
